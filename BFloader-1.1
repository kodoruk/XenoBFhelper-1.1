local function createToggleButton(parent, text)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -20, 0, 34)
    btn.BackgroundColor3 = Color3.fromRGB(30, 30, 45)
    btn.BorderSizePixel = 0
    btn.Text = "[OFF]  " .. text
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 13
    btn.Parent = parent

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 6)
    c.Parent = btn

    local s = Instance.new("UIStroke")
    s.Color = Color3.fromRGB(50, 50, 70)
    s.Thickness = 1
    s.Parent = btn

    local state = false

    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(45, 45, 65)}):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(30, 30, 45)}):Play()
    end)

    btn.MouseButton1Click:Connect(function()
        state = not state
        if state then
            btn.Text = "[ON]   " .. text
            btn.TextColor3 = Color3.fromRGB(0, 255, 120)
            s.Color = Color3.fromRGB(0, 255, 120)
        else
            btn.Text = "[OFF]  " .. text
            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            s.Color = Color3.fromRGB(50, 50, 70)
        end
    end)

    local function getState() return state end
    return btn, getState
end

local function createActionBtn(parent, text)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -20, 0, 34)
    btn.BackgroundColor3 = Color3.fromRGB(30, 30, 45)
    btn.BorderSizePixel = 0
