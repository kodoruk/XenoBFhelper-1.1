local pathRecBtn, pathRecOn = createToggleButton(mainPage, "Record Path")
local buildBtn = createActionBtn(mainPage, "Build Path (Line)")
local clearPathBtn = createActionBtn(mainPage, "Clear Path")

local recordedPoints = {}
local pathConn = nil
local pathVisuals = {}

local function clearPathVisuals()
    for _, v in pairs(pathVisuals) do
        if v and v.Parent then v:Destroy() end
    end
    pathVisuals = {}
end

pathRecBtn.MouseButton1Click:Connect(function()
    if pathRecOn() then
        recordedPoints = {}
        local timer = 0
        pathConn = RunService.Heartbeat:Connect(function(dt)
            timer += dt
            if timer >= Config.pathRecordInterval then
                timer = 0
                local char = player.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    local pos = char.HumanoidRootPart.Position
                    if #recordedPoints == 0 or (recordedPoints[#recordedPoints] - pos).Magnitude > Config.pathMinDistance then
                        table.insert(recordedPoints, pos)
                    end
                end
            end
        end)
    else
        if pathConn then pathConn:Disconnect() pathConn = nil end
    end
end)

buildBtn.MouseButton1Click:Connect(function()
    clearPathVisuals()
    if #recordedPoints < 2 then return end

    local pathFolder = Instance.new("Folder")
    pathFolder.Name = "XenoPath"
    pathFolder.Parent = Workspace
    table.insert(pathVisuals, pathFolder)

    for i = 1, #recordedPoints - 1 do
        local p1 = recordedPoints[i]
        local p2 = recordedPoints[i + 1]
        local dist = (p2 - p1).Magnitude
        local mid = (p1 + p2) / 2

        local part = Instance.new("Part")
        part.Anchored = true
        part.CanCollide = false
        part.Material = Enum.Material.Neon
        part.Color = Color3.fromRGB(0, 255, 150)
        part.Size = Vector3.new(0.2, 0.2, dist)
        part.CFrame = CFrame.lookAt(mid, p2)
        part.Parent = pathFolder
        table.insert(pathVisuals, part)

        local marker = Instance.new("Part")
        marker.Anchored = true
        marker.CanCollide = false
        marker.Material = Enum.Material.Neon
        marker.Color = Color3.fromRGB(255, 200, 0)
        marker.Size = Vector3.new(0.5, 0.5, 0.5)
        marker.Position = p1
        marker.Parent = pathFolder
        table.insert(pathVisuals, marker)
    end

    local lastMarker = Instance.new("Part")
    lastMarker.Anchored = true
    lastMarker.CanCollide = false
    lastMarker.Material = Enum.Material.Neon
    lastMarker.Color = Color3.fromRGB(255, 200, 0)
    lastMarker.Size = Vector3.new(0.5, 0.5, 0.5)
    lastMarker.Position = recordedPoints[#recordedPoints]
    lastMarker.Parent = pathFolder
    table.insert(pathVisuals, lastMarker)
end)

clearPathBtn.MouseButton1Click:Connect(function()
    clearPathVisuals()
    recordedPoints = {}
end)

