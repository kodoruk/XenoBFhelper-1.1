local function updateInfoLabels()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player then
            if not infoLabels[p] then createInfoLabel(p) end
            local data = infoLabels[p]
            if not data then return end

            if p.Character then
                local char = p.Character
                local head = char:FindFirstChild("Head")
                local hum = char:FindFirstChildOfClass("Humanoid")
                local root = char:FindFirstChild("HumanoidRootPart")

                if head and hum and root then
                    local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
                    local dist = myRoot and (root.Position - myRoot.Position).Magnitude or 0

                    if dist > Config.infoMaxDistance then
                        data.bb.Parent = nil
                        return
                    end

                    if data.bb.Parent ~= head then
                        data.bb.Parent = head
                    end

                    local heldItem = "пусто"
                    for _, item in ipairs(char:GetChildren()) do
                        if item:IsA("Tool") then heldItem = item.Name break end
                    end

                    local hp = math.floor(hum.Health)
                    local maxHp = math.floor(hum.MaxHealth)
                    local lookDir = head.CFrame.LookVector
                    local angle = math.deg(math.atan2(lookDir.X, -lookDir.Z))
                    if angle < 0 then angle += 360 end

                    data.label.Text = string.format(
                        "%s\nHP: %d / %d\n: %s\n: %d\n: %d\n: %d",
                        p.DisplayName or p.Name,
                        hp, maxHp,
                        heldItem,
                        math.floor(angle),
                        math.floor(dist),
                        math.floor(hum.WalkSpeed)
                    )
                end
            else
                data.bb.Parent = nil
            end
        end
    end
end

infoBtn.MouseButton1Click:Connect(function()
    if infoOn() then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= player then createInfoLabel(p) end
        end
        infoConn = RunService.Heartbeat:Connect(function(dt)
            infoTimer += dt
            if infoTimer >= Config.infoUpdateRate then
                infoTimer = 0
                updateInfoLabels()
            end
        end)
    else
        if infoConn then infoConn:Disconnect() infoConn = nil end
        clearInfoLabels()
    end
end)

Players.PlayerRemoving:Connect(function(p)
    if infoLabels[p] then
        if infoLabels[p].bb then infoLabels[p].bb:Destroy() end
        infoLabels[p] = nil
    end
end)

-- =====================
--  Перетаскивание
-- =====================

local dragging = false
local dragStart, startPos

header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = mainFrame.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        mainFrame.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

-- =====================
--  Сворачивание
-- =====================

local collapsed = false
local expandedSize = UDim2.new(0, 400, 0, 380)
local collapsedSize = UDim2.new(0, 50, 0, 50)

toggleBtn.MouseButton1Click:Connect(function()
    collapsed = not collapsed
    if collapsed then
        TweenService:Create(mainFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut), {
            Size = collapsedSize
        }):Play()
        sidebar.Visible = false
        contentArea.Visible = false
        title.Visible = false
        toggleBtn.Text = "+"
        TweenService:Create(toggleBtn, TweenInfo.new(0.25), {
            Position = UDim2.new(0.5, -12, 0.5, -12),
        }):Play()
    else
        TweenService:Create(mainFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut), {
            Size = expandedSize
        }):Play()
        sidebar.Visible = true
        contentArea.Visible = true
        title.Visible = true
        toggleBtn.Text = "—"
        TweenService:Create(toggleBtn, TweenInfo.new(0.25), {
            Position = UDim2.new(1, -30, 0.5, -12),
        }):Play()
    end
end)

