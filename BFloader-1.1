-- 1) ESP
local espBtn, espOn = createToggleButton(mainPage, "ESP")
local espHighlights = {}

local function clearESP()
    for _, h in pairs(espHighlights) do
        if h and type(h) == "table" then
            for _, obj in ipairs(h) do
                if obj and obj.Parent then obj:Destroy() end
            end
        end
    end
    espHighlights = {}
end

local function setupESPForPlayer(p)
    if p == player then return end
    local char = p.Character
    if not char then return end

    local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    local root = char:FindFirstChild("HumanoidRootPart")
    if root and myRoot then
        local dist = (root.Position - myRoot.Position).Magnitude
        if dist > Config.espMaxDistance then return end
    end

    local hl = Instance.new("Highlight")
    hl.Name = "XenoESP"
    hl.FillColor = Color3.fromRGB(255, 0, 0)
    hl.FillTransparency = Config.espFillTransparency
    hl.OutlineColor = Color3.fromRGB(255, 50, 50)
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = char

    local head = char:FindFirstChild("Head")
    local bb = nil
    if head then
        bb = Instance.new("BillboardGui")
        bb.Name = "XenoESPLabel"
        bb.Size = UDim2.new(0, 150, 0, 40)
        bb.StudsOffset = Vector3.new(0, 2, 0)
        bb.AlwaysOnTop = true
        bb.Parent = head

        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(1, 0, 1, 0)
        lbl.BackgroundTransparency = 1
        lbl.Text = p.Name
        lbl.TextColor3 = Color3.fromRGB(255, 50, 50)
        lbl.Font = Enum.Font.GothamBold
        lbl.TextSize = 14
        lbl.Parent = bb
    end

    espHighlights[p] = {hl, bb}
end

local espConn, espTimer = nil, 0

espBtn.MouseButton1Click:Connect(function()
    if espOn() then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= player then
                p.CharacterAdded:Connect(function()
                    task.wait(0.5)
                    if espOn() then setupESPForPlayer(p) end
                end)
                if p.Character then setupESPForPlayer(p) end
            end
        end
        -- Периодическое обновление с учётом конфига
        espConn = RunService.Heartbeat:Connect(function(dt)
            espTimer += dt
            if espTimer >= Config.espUpdateRate then
                espTimer = 0
                clearESP()
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= player and p.Character then
                        setupESPForPlayer(p)
                    end
                end
            end
        end)
    else
        if espConn then espConn:Disconnect() espConn = nil end
        clearESP()
    end
end)

Players.PlayerRemoving:Connect(function(p)
    if espHighlights[p] then
        for _, obj in ipairs(espHighlights[p]) do
            if obj and obj.Parent then obj:Destroy() end
        end
        espHighlights[p] = nil
    end
end)

