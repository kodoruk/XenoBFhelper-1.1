    c.Parent = frame

    local s = Instance.new("UIStroke")
    s.Color = Color3.fromRGB(45, 45, 65)
    s.Thickness = 1
    s.Parent = frame

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(0.6, 0, 1, 0)
    lbl.Position = UDim2.new(0, 10, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = text
    lbl.TextColor3 = Color3.fromRGB(200, 200, 215)
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 12
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = frame

    local valBtn = Instance.new("TextButton")
    valBtn.Size = UDim2.new(0, 70, 0, 24)
    valBtn.Position = UDim2.new(1, -78, 0.5, -12)
    valBtn.BackgroundColor3 = Color3.fromRGB(0, 204, 255)
    valBtn.Text = tostring(values[defaultIdx])
    valBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    valBtn.Font = Enum.Font.GothamBold
    valBtn.TextSize = 12
    valBtn.Parent = frame

    local vc = Instance.new("UICorner")
    vc.CornerRadius = UDim.new(0, 4)
    vc.Parent = valBtn

    local idx = defaultIdx

    valBtn.MouseButton1Click:Connect(function()
        idx = idx + 1
        if idx > #values then idx = 1 end
        valBtn.Text = tostring(values[idx])
        callback(values[idx])
    end)

    return frame, valBtn
end

